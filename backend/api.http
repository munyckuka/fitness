### ============================================================
### FITNESS API — GoLand HTTP Client
### Выбери environment "dev" (Alt+Enter на строке с {{host}})
### Токены сохраняются автоматически после Register / Login
### ============================================================


### ──────────────────────────────────────────────
### AUTH
### ──────────────────────────────────────────────

### 1. Регистрация (запусти первым — сохранит токены)
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "name": "Тест Юзер",
  "login": "testuser",
  "email": "test@fitness.dev",
  "password": "password123",
  "age": 25,
  "height": 180,
  "weight": 80,
  "fitnessLevel": "intermediate",
  "fitnessGoal": "strength",
  "frequency": 3,
  "equipment": ["barbell", "dumbbell", "bodyweight"]
}

> {%
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
  client.global.set("userId", response.body.user.id);
  client.log("✅ Токены сохранены. userId=" + response.body.user.id);
%}

###

### 2. Логин по email
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "identifier": "test@fitness.dev",
  "password": "password123"
}

> {%
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
  client.global.set("userId", response.body.user.id);
  client.log("✅ Логин успешен. userId=" + response.body.user.id);
%}

###

### 3. Логин по логину
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "identifier": "testuser",
  "password": "password123"
}

> {%
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
  client.global.set("userId", response.body.user.id);
%}

###

### 4. Refresh токена
POST {{host}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
  client.log("✅ Токены обновлены");
%}

###

### 5. Logout
POST {{host}}/api/v1/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}


### ──────────────────────────────────────────────
### USERS
### ──────────────────────────────────────────────

### 6. Получить текущего пользователя
GET {{host}}/api/v1/users/me
Authorization: Bearer {{accessToken}}

###

### 7. Обновить профиль (с preferences)
PUT {{host}}/api/v1/users/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Тест Юзер",
  "login": "testuser",
  "age": 25,
  "height": 180,
  "weight": 79.5,
  "fitnessLevel": "intermediate",
  "fitnessGoal": "strength",
  "frequency": 3,
  "equipment": ["barbell", "dumbbell", "bodyweight"],
  "preferences": {
    "daysOfWeek": [1, 3, 5],
    "split": "ppl",
    "remember": true
  }
}

###

### 8. Поиск пользователей по логину
GET {{host}}/api/v1/users/search?login=test
Authorization: Bearer {{accessToken}}


### ──────────────────────────────────────────────
### EXERCISES
### ──────────────────────────────────────────────

### 9. Все упражнения
GET {{host}}/api/v1/exercises/

###

### 10. Фильтр по мышце
GET {{host}}/api/v1/exercises/?muscle=chest

###

### 11. Поиск по названию
GET {{host}}/api/v1/exercises/?q=press&limit=10

###

### 12. Комбо фильтр
GET {{host}}/api/v1/exercises/?muscle=back&limit=5


### ──────────────────────────────────────────────
### WORKOUTS — ГЕНЕРАЦИЯ
### ──────────────────────────────────────────────

### 13. Генерация тренировки (минимум)
POST {{host}}/api/v1/workouts/generate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

> {%
  client.global.set("workoutId", response.body.workout.id);
  client.log("✅ Тренировка создана. id=" + response.body.workout.id);
  client.log("   split=" + response.body.workout.splitPart);
  client.log("   exercises=" + response.body.workout.exercises.length);
%}

###

### 14. Генерация с recovery-метриками (влияет на веса)
### sleepHours < 7 → -10% к весу, stressLevel > 8 → -10% к весу
POST {{host}}/api/v1/workouts/generate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "dayIndex": 1,
  "sleepHours": 5,
  "sleepQuality": 6,
  "stressLevel": 4,
  "preferences": {
    "daysOfWeek": [1, 3, 5],
    "split": "ppl",
    "remember": true
  }
}

> {%
  client.global.set("workoutId", response.body.workout.id);
  client.log("✅ Тренировка с recovery. id=" + response.body.workout.id);
  if (response.body.recoveryHint) {
    client.log("   hint=" + response.body.recoveryHint);
  }
%}

###

### 15. Генерация всей недели (startDate = понедельник недели)
POST {{host}}/api/v1/workouts/generate-week
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "startDate": "2026-06-08"
}

###

### 16. Список тренировок пользователя
GET {{host}}/api/v1/workouts/user/{{userId}}


### ──────────────────────────────────────────────
### WORKOUTS — ЗАВЕРШЕНИЕ
### ──────────────────────────────────────────────

### 17. Завершить тренировку (заполни workoutId и exerciseId после запроса #13)
### workoutId берётся автоматически из шага 13 или 14
### exerciseId — скопируй из ответа шага 13: workout.exercises[0].exerciseId
POST {{host}}/api/v1/workouts/complete
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "workoutId": "{{workoutId}}",
  "difficulty": 7,
  "sleepHours": 7,
  "sleepQuality": 8,
  "stressLevel": 3,
  "exercises": [
    {
      "exerciseId": "3e07238b-0d01-4e1a-835c-e904ea6988ed",
      "cycle": 0,
      "rpe": 7.5,
      "formQuality": 4,
      "sets": [
        { "reps": 5, "weight": 80, "rpe": 7.0 },
        { "reps": 5, "weight": 80, "rpe": 7.5 },
        { "reps": 4, "weight": 80, "rpe": 8.5 },
        { "reps": 4, "weight": 80, "rpe": 9.0 }
      ]
    }
  ]
}


### ──────────────────────────────────────────────
### WORKOUTS — ЗАМЕНА УПРАЖНЕНИЯ
### ──────────────────────────────────────────────

### 18. Заменить упражнение в тренировке
### workoutId — из шага 13, oldExerciseId и newExerciseId — из /exercises/
PATCH {{host}}/api/v1/workouts/{{workoutId}}/exercises/3e07238b-0d01-4e1a-835c-e904ea6988ed
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "newExerciseId": "3c47789b-b0ae-4791-bcf4-f694cb49fe6a"
}


### ──────────────────────────────────────────────
### IMPORT SHARED WORKOUT
### ──────────────────────────────────────────────

### 19. Импорт шаренной тренировки (создаёт workout из произвольных упражнений)
POST {{host}}/api/v1/workouts/import-shared
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "exercises": [
    { "exerciseId": "3e07238b-0d01-4e1a-835c-e904ea6988ed", "sets": 4, "reps": 8, "rest": 90, "weight": 70 },
    { "exerciseId": "3fa51b37-dee7-4e43-b4c4-99934676cf5e", "sets": 3, "reps": 12, "rest": 60, "weight": 20 },
    { "exerciseId": "b43dda67-8354-4a3e-9f61-4f423694558b", "sets": 3, "reps": 15, "rest": 60, "weight": 0 }
  ]
}

> {%
  client.global.set("workoutId", response.body.id);
  client.log("✅ Импорт успешен. id=" + response.body.id);
%}


### ──────────────────────────────────────────────
### PROGRESS
### ──────────────────────────────────────────────

### 20. Прогресс пользователя (заполняется после complete)
GET {{host}}/api/v1/progress/{{userId}}


### ──────────────────────────────────────────────
### CHAT
### ──────────────────────────────────────────────

### 21. Список диалогов
GET {{host}}/api/v1/chats/dialogs
Authorization: Bearer {{accessToken}}

###

### 22. Создать диалог с пользователем (нужен второй userId)
POST {{host}}/api/v1/chats/dialogs
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "peerUserId": "SECOND_USER_UUID"
}

> {%
  client.global.set("conversationId", response.body.conversationId);
%}

###

### 23. Отправить сообщение
POST {{host}}/api/v1/chats/dialogs/{{conversationId}}/messages
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "text": "Привет! Как тренировка?",
  "kind": "text"
}

###

### 24. Список сообщений
GET {{host}}/api/v1/chats/dialogs/{{conversationId}}/messages?limit=20
Authorization: Bearer {{accessToken}}

###

### 25. Отметить как прочитанное (messageId из ответа #23)
POST {{host}}/api/v1/chats/dialogs/{{conversationId}}/read
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "messageId": "MESSAGE_UUID"
}
