# База данных
# Neon:    postgresql://user:pass@host/dbname?sslmode=require&channel_binding=require
# Локальная: postgres://postgres:123456@localhost:5433/workoutdb?sslmode=disable
DATABASE_URL=

# JWT — любая случайная строка, минимум 32 символа
JWT_SECRET=

# Порт сервера (по умолчанию 8080)
PORT=8080
